# --- Yönetici hesabı (kayıt paneli: /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Oturum çerezlerini imzalamak için uzun rastgele değer (en az 32 karakter)
SESSION_SECRET=

# Vercel Blob – projeye Blob deposu bağlandığında Vercel otomatik tanımlar
BLOB_READ_WRITE_TOKEN=

# Sitenin herkese açık adresi (paylaşım önizleme görseli için, ör. https://forum.talpa.org)
APP_URL=

# --- Odoo üyelik doğrulama ("TALPA üyesiyim" → TC ile otomatik doldurma) ---
# Bağlantı (API anahtarı: Odoo › Tercihlerim › Hesap Güvenliği › Yeni API Anahtarı; salt okunur bir kullanıcı önerilir)
ODOO_URL=https://talpa.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
# Üye kaydının bulunduğu model ve TC alanının teknik adı
ODOO_MEMBER_MODEL=res.partner
ODOO_TC_FIELD=x_tc_kimlik_no
# Yalnızca aktif üyeleri eşleştiren ek Odoo domain'i (JSON dizi), ör. [["membership_state","in",["paid","free"]]]
ODOO_MEMBER_DOMAIN=[]
# Formu doldurmak için okunacak alanlar (virgülle; ilk dolu olan kullanılır)
ODOO_NAME_FIELDS=name
ODOO_EMAIL_FIELDS=email
ODOO_PHONE_FIELDS=mobile,phone
ODOO_ORGANIZATION_FIELDS=
